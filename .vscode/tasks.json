{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build+start: 编译并启动",
      "type": "npm",
      "script": "start:build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "lol-mate-stats-start",
        "pattern": { "regexp": "$^" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "正在连接|开始|web",
          "endsPattern": "面板已启动"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "lol-mate-stats",
        "clear": true,
        "close": true
      }
    },
    {
      "label": "typecheck: 类型检查",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "test: 评分测试",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "dev: 面板（tsx watch）",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "lol-mate-stats-dev",
        "pattern": { "regexp": "$^" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "正在连接|开始|web",
          "endsPattern": "面板已启动"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "lol-mate-stats",
        "clear": true,
        "close": true
      }
    },
    {
      "label": "demo: 模拟数据预览",
      "type": "npm",
      "script": "demo",
      "isBackground": true,
      "problemMatcher": {
        "owner": "lol-mate-stats-demo",
        "pattern": { "regexp": "$^" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "演示模式|面板已启动",
          "endsPattern": "浏览器打开|按 Ctrl\\+C 退出"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "lol-mate-stats",
        "clear": true,
        "close": true
      }
    },
    {
      "label": "doctor: 环境诊断",
      "type": "npm",
      "script": "doctor",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
