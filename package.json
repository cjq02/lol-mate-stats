{
  "name": "lol-mate-stats",
  "version": "0.1.0",
  "private": true,
  "description": "英雄联盟选人阶段队友近期战绩与评分面板（基于本地 LCU API，支持国服/外服）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lol-mate-stats": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "start:build": "npm run build && node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx --disable-warning=ExperimentalWarning watch src/index.ts",
    "once": "tsx --disable-warning=ExperimentalWarning src/index.ts once",
    "scan": "tsx --disable-warning=ExperimentalWarning src/index.ts scan",
    "demo": "tsx --disable-warning=ExperimentalWarning src/index.ts demo",
    "doctor": "tsx --disable-warning=ExperimentalWarning src/index.ts doctor",
    "test": "tsx --disable-warning=ExperimentalWarning src/stats/rating.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
