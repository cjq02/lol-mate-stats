# 复制为 .env 后修改。已有的真实环境变量优先于这里的值。

# 远程 MySQL（启动时自动建表；连不上时面板仍可使用，只是不保存缓存）
LOL_MATE_MYSQL_HOST=你的服务器IP
LOL_MATE_MYSQL_PORT=3306
LOL_MATE_MYSQL_USER=lol_mate_user
LOL_MATE_MYSQL_PASSWORD=你的密码
LOL_MATE_MYSQL_DATABASE=lol_mate_stats

# 本地数据目录：装备图标、导入用的旧 cache.db 等仍放在本机
# 不填则使用 Windows「文档」目录下的 lol-mate-stats
# LOL_MATE_DATA_DIR=E:\lol-mate-stats

# 可选：走 SSH 隧道时把 HOST 改成 127.0.0.1，PORT 改成隧道端口
# ssh -N -L 13306:127.0.0.1:3306 cjq.tencent
# LOL_MATE_MYSQL_HOST=127.0.0.1
# LOL_MATE_MYSQL_PORT=13306

# 可选：MySQL 要求 TLS 时打开（公网直连建议开启）
# 服务端使用自签名证书时只加密、不校验证书
# LOL_MATE_MYSQL_SSL=1

# 面板端口
# PORT=51730

# 每位玩家读取的场次
# RECENT_GAMES=10

# AI 分析（本局详情里的“AI 分析”按钮）
# 在 https://opencode.ai/console 创建 OpenCode Go API Key 后粘贴到下面
# LOL_MATE_AI_API_KEY=

# 可选：自定义接口和模型，默认 OpenCode Go + DeepSeek V4.1 Flash
# LOL_MATE_AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LOL_MATE_AI_MODEL=deepseek-v4.1-flash
# LOL_MATE_AI_DISABLED=1
